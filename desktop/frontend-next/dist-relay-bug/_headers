# The shell names the build that is current, and the page's own out-of-date
# check reads this same file over no-store. A cached or revalidated copy makes
# an open page look behind and keeps reloading onto it. Hashed bundles under
# /assets are the opposite: they are named by content, so they never change.
/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
